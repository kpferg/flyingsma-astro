# Contentful CMS Configuration
# Get these values from your Contentful space settings.
#
# These are read by client-side scripts, so they must carry the PUBLIC_ prefix
# or Astro will not expose them to the browser. Use a Content Delivery API
# token only — it is read-only. Never put a Content Management API token here.
#
# All three are optional: src/lib/contentful.ts falls back to the production
# space, so the site builds without any .env file. Set these to point a build
# at a different space.
PUBLIC_CONTENTFUL_SPACE_ID=your_space_id_here
PUBLIC_CONTENTFUL_ACCESS_TOKEN=your_access_token_here
PUBLIC_CONTENTFUL_ENVIRONMENT=master

# Google Analytics / Tag Manager
# Get these from your Google Analytics or Tag Manager account
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

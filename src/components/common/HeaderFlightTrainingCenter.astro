---
import site from '../../data/site.json';

const social = site.social;
---

<header class="bg-white shadow-sm sticky top-0 z-50 border-b-2 border-blue-600">
  <nav class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <!-- Logo & Brand -->
      <a href="/flight-training-center" class="flex items-center gap-3">
        <img
          src="/images/logo/SMALogo.png"
          alt="Southern Maine Aviation"
          class="h-10 w-auto"
        />
        <div class="hidden sm:block">
          <span class="text-sm text-gray-500">Southern Maine Aviation</span>
          <span class="block text-lg font-semibold text-sky-600 -mt-1">Flight Training Center</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden nav:flex items-center gap-1">
        <!-- Primary Links -->
        <a
          href="https://app.flightschedulepro.com/Account/Login/186067"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-2 text-sky-600 hover:text-sky-700 font-medium rounded-md hover:bg-sky-50 transition-colors flex items-center gap-1"
        >
          <i class="fa-solid fa-calendar-days text-sm"></i>
          Scheduling
        </a>
        <a href="/flight-training-center" class="px-3 py-2 text-gray-700 hover:text-sky-600 font-medium rounded-md hover:bg-sky-50 transition-colors">
          Training
        </a>
        <a href="/flight-training-center/scenic-flights" class="px-3 py-2 text-gray-700 hover:text-sky-600 font-medium rounded-md hover:bg-sky-50 transition-colors">
          Scenic Flights
        </a>

        <!-- More Dropdown -->
        <div class="relative group">
          <button class="px-3 py-2 text-gray-700 hover:text-sky-600 font-medium rounded-md hover:bg-sky-50 transition-colors flex items-center gap-1">
            More
            <i class="fa-solid fa-chevron-down text-xs transition-transform group-hover:rotate-180"></i>
          </button>
          <div class="absolute right-0 mt-1 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pt-2">
            <div class="bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 py-1">
              <a href="/flight-training-center/contact" class="px-3 py-2 text-gray-700 hover:text-sky-600 font-medium rounded-md hover:bg-sky-50 transition-colors">
                Contact
              </a><a href="/flight-training-center/multi-engine" class="block px-4 py-2 text-sm text-gray-700 hover:bg-sky-50 hover:text-sky-600">
                Multi-Engine Training
              </a>
              <a href="/flight-training-center/formation-training" class="block px-4 py-2 text-sm text-gray-700 hover:bg-sky-50 hover:text-sky-600">
                Formation Academy
              </a>
              <a href="/flight-training-center/news" class="block px-4 py-2 text-sm text-gray-700 hover:bg-sky-50 hover:text-sky-600">
                News
              </a>
              <div class="border-t border-gray-100 my-1"></div>
              <a
                href="https://flight-release-sma.netlify.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="block px-4 py-2 text-sm text-sky-600 hover:bg-sky-50 flex items-center gap-2"
              >
                <i class="fa-solid fa-clipboard-list w-4"></i>
                Flight Release
              </a>
              <div class="border-t border-gray-100 my-1"></div>
              <a href="/fbo-services" class="block px-4 py-2 text-sm text-gray-500 hover:bg-gray-50">
                Switch to FBO Services →
              </a>
            </div>
          </div>
        </div>

        <!-- Social Media Links -->
        {(social.facebook || social.instagram || (social.linkedin && social.linkedin.trim())) && (
          <div class="flex items-center gap-2 ml-2 border-l border-gray-200 pl-3">
            {social.facebook && (
              <a
                href={social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 hover:text-sky-600 transition-colors"
                aria-label="Facebook"
              >
                <i class="fa-brands fa-facebook text-xl"></i>
              </a>
            )}
            {social.instagram && (
              <a
                href={social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 hover:text-sky-600 transition-colors"
                aria-label="Instagram"
              >
                <i class="fa-brands fa-instagram text-xl"></i>
              </a>
            )}
            {social.linkedin && social.linkedin.trim() && (
              <a
                href={social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 hover:text-sky-600 transition-colors"
                aria-label="LinkedIn"
              >
                <i class="fa-brands fa-linkedin text-xl"></i>
              </a>
            )}
          </div>
        )}

        <!-- Call Button -->
        <a
          href={`tel:${site.contact.flight.phone}`}
          class="ml-3 px-4 py-2 bg-sky-600 text-white text-sm font-medium rounded-lg hover:bg-sky-700 transition-colors flex items-center gap-2"
        >
          <i class="fa-solid fa-phone"></i>
          <span class="hidden nav:inline">{site.contact.flight.phone}</span>
          <span class="nav:hidden">Call</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        class="nav:hidden text-gray-700 p-2 hover:bg-gray-100 rounded-lg transition-colors"
        id="mobile-menu-button-fs"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="menu-icon"><i class="fa-solid fa-bars text-xl"></i></span>
        <span class="close-icon hidden"><i class="fa-solid fa-xmark text-xl"></i></span>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div class="hidden nav:hidden pb-4" id="mobile-menu-fs">
      <div class="pt-4 border-t border-gray-100 space-y-1">
        <a
          href="https://app.flightschedulepro.com/Account/Login/186067"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-3 py-2 text-sky-600 hover:bg-sky-50 rounded-md font-medium"
        >
          <i class="fa-solid fa-calendar-days w-5"></i>
          Scheduling
        </a>
        <a href="/flight-training-center" class="block px-3 py-2 text-gray-700 hover:bg-sky-50 hover:text-sky-600 rounded-md font-medium">
          Flight Training
        </a>
        <a href="/flight-training-center/scenic-flights" class="block px-3 py-2 text-gray-700 hover:bg-sky-50 hover:text-sky-600 rounded-md font-medium">
          Scenic Flights
        </a>
        <a href="/flight-training-center/multi-engine" class="block px-3 py-2 text-gray-700 hover:bg-sky-50 hover:text-sky-600 rounded-md font-medium">
          Multi-Engine
        </a>
        <a href="/flight-training-center/formation-training" class="block px-3 py-2 text-gray-700 hover:bg-sky-50 hover:text-sky-600 rounded-md font-medium">
          Formation Academy
        </a>
        <a href="/flight-training-center/news" class="block px-3 py-2 text-gray-700 hover:bg-sky-50 hover:text-sky-600 rounded-md font-medium">
          News
        </a>
        <a href="/flight-training-center/contact" class="block px-3 py-2 text-gray-700 hover:bg-sky-50 hover:text-sky-600 rounded-md font-medium">
          Contact
        </a>

        <div class="pt-3 mt-3 border-t border-gray-100 space-y-1">
          <a
            href="https://flight-release-sma.netlify.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-3 py-2 text-sky-600 hover:bg-sky-50 rounded-md font-medium"
          >
            <i class="fa-solid fa-clipboard-list w-5"></i>
            Flight Release
          </a>
        </div>

        <div class="pt-3 mt-3 border-t border-gray-100">
          <a
            href={`tel:${site.contact.flight.phone}`}
            class="flex items-center justify-center gap-2 w-full px-4 py-3 bg-sky-600 text-white font-medium rounded-lg hover:bg-sky-700 transition-colors"
          >
            <i class="fa-solid fa-phone"></i>
            Call: {site.contact.flight.phone}
          </a>
        </div>

        <div class="pt-3 mt-3 border-t border-gray-100">
          <a href="/fbo-services" class="block px-3 py-2 text-gray-500 hover:text-gray-700 text-sm">
            Switch to FBO Services →
          </a>
        </div>

        <!-- Social Media Links -->
        {(social.facebook || social.instagram || (social.linkedin && social.linkedin.trim())) && (
          <div class="pt-3 mt-3 border-t border-gray-100">
            <div class="flex items-center gap-4 px-3">
              {social.facebook && (
                <a
                  href={social.facebook}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-600 hover:text-sky-600 transition-colors"
                  aria-label="Facebook"
                >
                  <i class="fa-brands fa-facebook text-2xl"></i>
                </a>
              )}
              {social.instagram && (
                <a
                  href={social.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-600 hover:text-sky-600 transition-colors"
                  aria-label="Instagram"
                >
                  <i class="fa-brands fa-instagram text-2xl"></i>
                </a>
              )}
              {social.linkedin && social.linkedin.trim() && (
                <a
                  href={social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-600 hover:text-sky-600 transition-colors"
                  aria-label="LinkedIn"
                >
                  <i class="fa-brands fa-linkedin text-2xl"></i>
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button-fs');
  const mobileMenu = document.getElementById('mobile-menu-fs');
  const menuIcon = mobileMenuButton?.querySelector('.menu-icon');
  const closeIcon = mobileMenuButton?.querySelector('.close-icon');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      menuIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
      mobileMenuButton.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>

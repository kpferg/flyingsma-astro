---
import { getCollection } from 'astro:content';
import FlightTrainingCenterLayout from "../../layouts/FlightTrainingCenterLayout.astro";
import InstructorsSection from "../../components/sections/InstructorsSection.astro";
import FleetSection from "../../components/sections/FleetSection.astro";
import FAQSection from "../../components/sections/FAQSection.astro";
import NewsSection from "../../components/sections/NewsSection.astro";
import FAQSchema from "../../components/seo/FAQSchema.astro";
import BreadcrumbSchema from "../../components/seo/BreadcrumbSchema.astro";
import site from "../../data/site.json";

// Note: ContactSection removed - using inline contact section with map instead

// Get FAQ data for schema
const faqCollection = await getCollection('faq');
const faqItems = faqCollection
  .sort((a, b) => a.data.order - b.data.order)
  .map((item) => ({
    question: item.data.question,
    answer: item.data.answer,
  }));

const breadcrumbs = [
  { name: 'Home', url: 'https://www.flyingsma.com/' },
  { name: 'Flight Training Center', url: 'https://www.flyingsma.com/flight-training-center/' },
];
---

<FlightTrainingCenterLayout title="Flight Training" description="Learn to fly at Southern Maine Aviation. Private pilot, instrument, commercial, multi-engine, and tailwheel training.">
	<FAQSchema slot="head" faqs={faqItems} />
	<BreadcrumbSchema slot="head" items={breadcrumbs} />
	<link slot="head" href="//cdn-images.mailchimp.com/embedcode/classic-061523.css" rel="stylesheet" type="text/css" />
	<!-- Page Header -->
	<section class="relative text-white py-32 md:py-40 overflow-hidden">
		<!--
			Background Video

			Decorative, so it is hidden from assistive tech. Playback is started by
			script rather than the autoplay attribute, so that a reduced-motion
			preference can hold it on its first frame instead. The toggle below is
			required by WCAG 2.2.2 (Pause, Stop, Hide) either way.
		-->
		<video
			id="hero-video"
			class="absolute inset-0 w-full h-full object-cover"
			muted
			playsinline
			preload="auto"
			aria-hidden="true"
			tabindex="-1"
		>
			<source src="/images/hero/flight-training-hero.mp4" type="video/mp4" />
		</video>
		<!-- Gradient Overlay for readability -->
		<div class="absolute inset-0 bg-black/40"></div>

		<!-- Playback toggle -->
		<button
			id="hero-video-toggle"
			type="button"
			class="absolute bottom-4 right-4 z-20 hidden h-11 w-11 items-center justify-center rounded-full bg-black/50 text-white backdrop-blur-sm transition-colors hover:bg-black/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
			aria-label="Pause background video"
		>
			<i id="hero-video-toggle-icon" class="fa-solid fa-pause" aria-hidden="true"></i>
		</button>

		<div class="container mx-auto px-4 text-center relative z-10">
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 drop-shadow-lg">Learn To Fly Today!</h1>
			<p class="text-xl md:text-2xl text-sky-100 max-w-3xl mx-auto mb-8 drop-shadow">
				Whether you are a beginner or advanced, we can work with you to create the perfect program
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a
					href={`tel:${site.contact.flight.phone}`}
					class="inline-flex items-center px-8 py-4 bg-white text-sky-900 font-semibold rounded-lg hover:bg-sky-50 transition-colors shadow-lg"
				>
					<i class="fa-solid fa-phone mr-2"></i>
					Call or Text: {site.contact.flight.phone}
				</a>
				<a
					href="#programs"
					class="inline-flex items-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
				>
					View Programs
					<i class="fa-solid fa-chevron-down ml-2"></i>
				</a>
			</div>
		</div>
	</section>

	<!-- Quick Links & Contact Info -->
	<section class="py-8 bg-white border-b">
		<div class="container mx-auto px-4">
			<div class="flex flex-wrap justify-center gap-4 md:gap-8">
				<!-- Scheduling Link -->
				<a
					href={site.externalLinks.scheduling}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center px-6 py-3 bg-sky-600 text-white font-semibold rounded-lg hover:bg-sky-700 transition-colors"
				>
					<i class="fa-solid fa-calendar-days mr-2"></i>
					Scheduling for Current Customers
				</a>
				<!-- Contact Info -->
				<a
					href={`tel:${site.contact.flight.phone}`}
					class="inline-flex items-center px-6 py-3 border-2 border-blue-600 text-sky-600 font-semibold rounded-lg hover:bg-sky-50 transition-colors"
				>
					<i class="fa-solid fa-phone mr-2"></i>
					{site.contact.flight.phone}
				</a>
				<!-- Email -->
				<a
					href={`mailto:${site.contact.flight.email}`}
					class="inline-flex items-center px-6 py-3 border-2 border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 transition-colors"
				>
					<i class="fa-solid fa-envelope mr-2"></i>
					{site.contact.flight.email}
				</a>
			</div>
			<!-- Hours & Social -->
			<div class="flex flex-wrap justify-center items-center gap-6 mt-6 pt-6 border-t border-gray-200">
				<div class="text-center">
					<span class="text-sm text-gray-500">Hours:</span>
					<span class="ml-2 font-medium text-gray-700">{site.hours.fullDisplay}</span>
				</div>
				<div class="flex items-center gap-4">
					{site.social.facebook && (
						<a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-sky-600 transition-colors" aria-label="Facebook">
							<i class="fa-brands fa-facebook text-2xl"></i>
						</a>
					)}
					{site.social.instagram && (
						<a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-pink-600 transition-colors" aria-label="Instagram">
							<i class="fa-brands fa-instagram text-2xl"></i>
						</a>
					)}
					{site.social.linkedin && (
						<a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-sky-700 transition-colors" aria-label="LinkedIn">
							<i class="fa-brands fa-linkedin text-2xl"></i>
						</a>
					)}
				</div>
			</div>
		</div>
	</section>

	<!-- Training Programs -->
	<section class="py-16 bg-white" id="programs">
		<div class="container mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-gray-900 mb-4">Training Programs</h2>
				<p class="text-gray-600 max-w-2xl mx-auto">
					From your first flight to advanced ratings, we have a program for every aviation goal
				</p>
			</div>

			<!-- Professional Pilot Program - Featured Full-Width Card -->
			<div class="max-w-6xl mx-auto mb-8">
				<a href="/flight-training-center/professional-pilot-program" class="group relative overflow-hidden rounded-2xl shadow-2xl hover:shadow-3xl transition-all duration-500 block">
					<!-- Background -->
					<div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-sky-900 to-slate-800"></div>
					<!-- Decorative silhouettes -->
					<div class="absolute inset-0 overflow-hidden opacity-10" aria-hidden="true">
						<div class="absolute right-0 top-0 bottom-0 flex items-end gap-12 pr-8">
							<i class="fa-solid fa-plane text-[10rem] -rotate-6 translate-y-6"></i>
							<i class="fa-solid fa-plane text-[14rem] -rotate-3"></i>
							<i class="fa-solid fa-plane text-[10rem] rotate-6 translate-y-6"></i>
						</div>
					</div>
					<!-- Content -->
					<div class="relative z-10 p-8 md:p-10 flex flex-col md:flex-row md:items-center gap-6">
						<div class="flex-1">
							<div class="flex flex-wrap items-center gap-3 mb-3">
								<span class="bg-amber-400 text-amber-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">Coming Soon</span>
								<span class="bg-sky-500/30 text-sky-200 text-xs font-semibold px-3 py-1 rounded-full border border-sky-500/50">Career-Focused Training</span>
							</div>
							<h3 class="text-2xl md:text-3xl font-bold text-white mb-3">SMA Professional Pilot Program</h3>
							<p class="text-sky-200 text-base leading-relaxed max-w-2xl">
								A structured, career-focused training path for pilots serious about flying professionally. We're finalizing the details now — get in touch and we'll make sure you're the first to know when enrollment opens.
							</p>
						</div>
						<div class="flex-shrink-0">
							<span class="inline-flex items-center gap-2 px-6 py-3 bg-white text-sky-900 font-semibold rounded-lg group-hover:bg-sky-50 transition-colors text-sm md:text-base whitespace-nowrap">
								Learn More
								<i class="fa-solid fa-chevron-right transform group-hover:translate-x-1 transition-transform"></i>
							</span>
						</div>
					</div>
				</a>
			</div>

			<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
				<!-- Private Pilot -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow group">
					<div class="h-48 bg-gradient-to-br from-sky-600 to-blue-700 flex items-center justify-center">
						<i class="fa-solid fa-plane text-white/80 text-6xl"></i>
					</div>
					<div class="p-6">
						<h3 class="text-xl font-bold text-gray-900 mb-2">Private Pilot Certificate</h3>
						<p class="text-gray-600 mb-4">
							Your first step into aviation. Learn to fly and earn your wings with comprehensive ground and flight training.
						</p>
						<ul class="text-sm text-gray-500 space-y-1 mb-4">
							<li>• FAA minimum: 40 hours (typical: 60+ hours)</li>
							<li>• Includes ground school</li>
							<li>• Written and practical exams</li>
						</ul>
					</div>
				</div>

				<!-- Instrument Rating -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow group">
					<div class="h-48 bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
						<i class="fa-solid fa-gauge-high text-white/80 text-6xl"></i>
					</div>
					<div class="p-6">
						<h3 class="text-xl font-bold text-gray-900 mb-2">Instrument Rating</h3>
						<p class="text-gray-600 mb-4">
							Fly safely in clouds and low visibility conditions. Essential for serious pilots and career aviators.
						</p>
						<ul class="text-sm text-gray-500 space-y-1 mb-4">
							<li>• Fly in IMC conditions</li>
							<li>• Enhanced safety skills</li>
							<li>• Required for many careers</li>
						</ul>
					</div>
				</div>

				<!-- Commercial Certificate -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow group">
					<div class="h-48 bg-gradient-to-br from-green-600 to-green-700 flex items-center justify-center">
						<i class="fa-solid fa-user-pilot-tie text-white/80 text-6xl"></i>
					</div>
					<div class="p-6">
						<h3 class="text-xl font-bold text-gray-900 mb-2">Commercial Certificate</h3>
						<p class="text-gray-600 mb-4">
							Get paid to fly! The commercial certificate opens doors to professional aviation careers.
						</p>
						<ul class="text-sm text-gray-500 space-y-1 mb-4">
							<li>• Fly for compensation</li>
							<li>• Higher skill standards</li>
							<li>• Career opportunities</li>
						</ul>
					</div>
				</div>

				<!-- Multi-Engine -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow group border-2 border-blue-500">
					<div class="h-48 bg-gradient-to-br from-sky-700 to-indigo-800 flex items-center justify-center relative">
						<span class="absolute top-4 right-4 bg-yellow-400 text-yellow-900 text-xs font-bold px-3 py-1 rounded-full">
							NOW AVAILABLE
						</span>
						<i class="fa-solid fa-plane-prop text-white/80 text-6xl"></i>
					</div>
					<div class="p-6">
						<h3 class="text-xl font-bold text-gray-900 mb-2">Multi-Engine Rating</h3>
						<p class="text-gray-600 mb-4">
							Our beautiful twin engine trainer has arrived! Learn to fly multi-engine aircraft.
						</p>
						<a
							href="/flight-training-center/multi-engine"
							class="inline-flex items-center text-sky-600 hover:text-sky-800 font-medium"
						>
							Learn More
							<i class="fa-solid fa-chevron-right text-sm ml-1"></i>
						</a>
					</div>
				</div>

				<!-- Tailwheel -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow group">
					<div class="h-48 bg-gradient-to-br from-orange-600 to-orange-700 flex items-center justify-center">
						<i class="fa-solid fa-sunglasses text-white/80 text-6xl"></i>
					</div>
					<div class="p-6">
						<h3 class="text-xl font-bold text-gray-900 mb-2">Tailwheel Endorsement</h3>
						<p class="text-gray-600 mb-4">
							Master "stick and rudder" flying in our Citabria. True aviation at its finest.
						</p>
						<ul class="text-sm text-gray-500 space-y-1 mb-4">
							<li>• Classic flying experience</li>
							<li>• Enhanced coordination</li>
							<li>• Great for backcountry</li>
						</ul>
					</div>
				</div>

				<!-- Backcountry -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow group">
					<div class="h-48 bg-gradient-to-br from-emerald-600 to-emerald-700 flex items-center justify-center">
						<i class="fa-solid fa-mountain-sun text-white/80 text-6xl"></i>
					</div>
					<div class="p-6">
						<h3 class="text-xl font-bold text-gray-900 mb-2">Backcountry Experience</h3>
						<p class="text-gray-600 mb-4">
							Grass strips and remote flying. Adventure awaits beyond paved runways.
						</p>
						<ul class="text-sm text-gray-500 space-y-1 mb-4">
							<li>• Off-airport operations</li>
							<li>• Short field techniques</li>
							<li>• Adventure flying</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Discovery Flight CTA -->
	<section class="py-16 bg-sky-600">
		<div class="container mx-auto px-4 text-center">
			<h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Not Sure Where to Start?</h2>
			<p class="text-xl text-sky-100 max-w-2xl mx-auto mb-8">
				Take a Discovery Flight - your first lesson and introduction to the world of aviation. $200-240 depending on the aircraft, and includes a free logbook!
			</p>
			<a
				href={`tel:${site.contact.flight.phone}`}
				class="inline-flex items-center px-8 py-4 bg-white text-sky-600 font-semibold rounded-lg hover:bg-sky-50 transition-colors"
			>
				Schedule Your Discovery Flight
			</a>
		</div>
	</section>

	<!-- Newsletter Signup -->
	<section class="py-16 bg-white border-t border-gray-100">
		<div class="container mx-auto px-4 flex justify-center">
			<div id="mc_embed_signup" style="width: 100%; max-width: 600px;">
				<form action="https://flyingSMA.us3.list-manage.com/subscribe/post?u=7d1e5ed35bd2bfb82a1511171&amp;id=323e06607f&amp;f_id=009535e2f0" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" class="validate" target="_blank">
					<div id="mc_embed_signup_scroll">
						<h2>Subscribe to Our Newsletter</h2>
						<div class="indicates-required"><span class="asterisk">*</span> indicates required</div>
						<div class="mc-field-group"><label for="mce-FNAME">First Name <span class="asterisk">*</span></label><input type="text" name="FNAME" class="required text" id="mce-FNAME" required value=""></div>
						<div class="mc-field-group"><label for="mce-LNAME">Last Name <span class="asterisk">*</span></label><input type="text" name="LNAME" class="required text" id="mce-LNAME" value="" required></div>
						<div class="mc-field-group"><label for="mce-EMAIL">Email Address <span class="asterisk">*</span></label><input type="email" name="EMAIL" class="required email" id="mce-EMAIL" value="" required></div>
						<div id="mce-responses" class="clear foot">
							<div class="response" id="mce-error-response" style="display: none;"></div>
							<div class="response" id="mce-success-response" style="display: none;"></div>
						</div>
						<div aria-hidden="true" style="position: absolute; left: -5000px;">
							<input type="text" name="b_7d1e5ed35bd2bfb82a1511171_323e06607f" tabindex="-1" value="">
						</div>
						<div class="optionalParent">
							<div class="clear foot">
								<input type="submit" name="subscribe" id="mc-embedded-subscribe" class="button" value="Subscribe">
								<p style="margin: 0px auto;"><a href="http://eepurl.com/iRWZWM" title="Mailchimp - email marketing made easy and fun"><span style="display: inline-block; background-color: transparent; border-radius: 4px;"><img class="refferal_badge" src="https://digitalasset.intuit.com/render/content/dam/intuit/mc-fe/en_us/images/intuit-mc-rewards-text-dark.svg" alt="Intuit Mailchimp" style="width: 220px; height: 40px; display: flex; padding: 2px 0px; justify-content: center; align-items: center;"></span></a></p>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</section>

	<!-- News Section -->
	<NewsSection
		title="Flight Training Center News"
		description="Stay up to date with the latest happenings at our flight training center."
		limit={3}
		showViewAll={true}
		background="dark"
	/>

	<!-- Instructors Section -->
	<InstructorsSection
		title="Meet Our Instructors"
		description="Our experienced team of flight instructors are dedicated to helping you achieve your aviation goals."
		columns={4}
		variant="light"
	/>

	<!-- Fleet Section -->
	<FleetSection
		title="Our Fleet"
		description="We maintain a diverse fleet of well-equipped aircraft for all your training needs."
		variant="darker"
	/>

	<!-- FAQ Section -->
	<FAQSection
		title="Common Questions"
		description="Answers to frequently asked questions about learning to fly."
		grouped={false}
		background="dark"
	/>

	<!-- Contact & Map Section -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-gray-900 mb-4">Ready to Start Flying?</h2>
				<p class="text-gray-600 max-w-2xl mx-auto">
					Contact us to schedule your first lesson or ask any questions about our training programs.
				</p>
			</div>

			<div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<!-- Contact Info -->
				<div class="bg-white rounded-xl shadow-lg p-8">
					<h3 class="text-xl font-bold text-gray-900 mb-6">Flight Department</h3>
					<div class="space-y-4">
						<a href={`tel:${site.contact.flight.phone}`} class="flex items-center text-gray-700 hover:text-sky-600">
							<i class="fa-solid fa-phone w-5 mr-3 text-sky-600"></i>
							<span class="font-medium">{site.contact.flight.phone}</span>
							<span class="ml-2 text-sm text-gray-500">(Call or Text)</span>
						</a>
						<a href={`mailto:${site.contact.flight.email}`} class="flex items-center text-gray-700 hover:text-sky-600">
							<i class="fa-solid fa-envelope w-5 mr-3 text-sky-600"></i>
							<span class="font-medium">{site.contact.flight.email}</span>
						</a>
						<div class="flex items-start text-gray-700">
							<i class="fa-solid fa-location-dot w-5 mr-3 mt-1 text-sky-600"></i>
							<div>
								<p class="font-medium">{site.address.street1}</p>
								<p>{site.address.city}, {site.address.state} {site.address.zip}</p>
							</div>
						</div>
						<div class="flex items-center text-gray-700">
							<i class="fa-solid fa-clock w-5 mr-3 text-sky-600"></i>
							<div>
								<div>{site.hours.display}</div>
							</div>
						</div>
					</div>
					<div class="mt-6 pt-6 border-t border-gray-200">
						<a
							href="/flight-training-center/contact"
							class="inline-flex items-center px-6 py-3 bg-sky-600 text-white font-semibold rounded-lg hover:bg-sky-700 transition-colors w-full justify-center"
						>
							Contact Us
							<i class="fa-solid fa-chevron-right text-sm ml-2"></i>
						</a>
					</div>
				</div>

				<!-- Map -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden">
					<iframe
						src={site.maps.embedUrl}
						width="100%"
						height="100%"
						style="border:0; min-height: 400px;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						title="Southern Maine Aviation Location"
					></iframe>
				</div>
			</div>
		</div>
	</section>

<script slot="scripts" src="//s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js"></script>
<script slot="scripts">
(function($) {
	window.fnames = new Array(); window.ftypes = new Array();
	fnames[1]='FNAME'; ftypes[1]='text';
	fnames[2]='LNAME'; ftypes[2]='text';
	fnames[0]='EMAIL'; ftypes[0]='email';
}(jQuery));
var $mcj = jQuery.noConflict(true);
</script>

<script>
	const video = document.getElementById('hero-video') as HTMLVideoElement | null;
	const toggle = document.getElementById('hero-video-toggle') as HTMLButtonElement | null;
	const toggleIcon = document.getElementById('hero-video-toggle-icon');

	if (video && toggle && toggleIcon) {
		const PAUSE_MS = 60_000;  // hold on last frame for 1 minute
		const FADE_IN_MS = 2500;  // fade in duration

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let restartTimer: ReturnType<typeof setTimeout> | null = null;
		let fadeFrame: number | null = null;
		// Whether the loop as a whole is running — playing or resting between
		// plays. This, not video.paused, is what the button reports, since the
		// clip spends most of each cycle paused on its last frame by design.
		let loopRunning = false;
		// Tracks an explicit choice by the user, which outranks both the loop
		// timer and any later change to the motion preference.
		let pausedByUser = false;

		// The control is only useful with script running, so it ships hidden and
		// is revealed here.
		toggle.classList.remove('hidden');
		toggle.classList.add('flex');

		function cancelPendingRestart() {
			if (restartTimer !== null) {
				clearTimeout(restartTimer);
				restartTimer = null;
			}
		}

		function cancelFade() {
			if (fadeFrame !== null) {
				cancelAnimationFrame(fadeFrame);
				fadeFrame = null;
			}
		}

		function reflectState(playing: boolean) {
			toggle!.setAttribute('aria-label', playing ? 'Pause background video' : 'Play background video');
			toggleIcon!.className = playing ? 'fa-solid fa-pause' : 'fa-solid fa-play';
		}

		function fadeIn() {
			cancelFade();
			// A fade is itself motion, so skip straight to full opacity when the
			// user has asked for less of it.
			if (reduceMotion.matches) {
				video!.style.opacity = '1';
				return;
			}
			const startTime = performance.now();
			video!.style.opacity = '0';
			function step(now: number) {
				const opacity = Math.min(1, (now - startTime) / FADE_IN_MS);
				video!.style.opacity = String(opacity);
				fadeFrame = opacity < 1 ? requestAnimationFrame(step) : null;
			}
			fadeFrame = requestAnimationFrame(step);
		}

		function play(withFade: boolean) {
			if (withFade) fadeIn();
			else video!.style.opacity = '1';
			video!.play().catch(() => {
				// A hidden tab refuses playback, so treat that as "not yet" and
				// leave the loop armed for the visibilitychange handler to start.
				// A refusal on a visible page is the autoplay policy talking, and
				// the control should honestly offer to play instead.
				if (document.visibilityState === 'visible') {
					loopRunning = false;
					reflectState(false);
				}
			});
		}

		function startLoop(withFade: boolean) {
			loopRunning = true;
			reflectState(true);
			// The clip ends well before the hold does, so a click during the hold
			// should begin again rather than resume an already-finished element.
			if (video!.ended) video!.currentTime = 0;
			play(withFade);
		}

		function stopLoop() {
			loopRunning = false;
			cancelPendingRestart();
			cancelFade();
			video!.pause();
			video!.style.opacity = '1';
			reflectState(false);
		}

		toggle.addEventListener('click', () => {
			if (loopRunning) {
				pausedByUser = true;
				stopLoop();
			} else {
				pausedByUser = false;
				startLoop(false);
			}
		});

		video.addEventListener('ended', () => {
			if (!loopRunning) return;
			// The clip is a few seconds long and then rests on its last frame for
			// a minute. That hold is still part of the loop, so the control keeps
			// offering "pause" rather than flipping to "play" for most of the cycle.
			cancelPendingRestart();
			restartTimer = setTimeout(() => {
				video!.currentTime = 0;
				play(true);
			}, PAUSE_MS);
		});

		// Browsers pause hidden tabs and may not resume on return, which would
		// otherwise strand the loop paused while the button still said "pause".
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState !== 'visible') return;
			if (loopRunning && video!.paused && !video!.ended && restartTimer === null) {
				play(false);
			}
		});

		// Follow the preference if it changes while the page is open.
		reduceMotion.addEventListener('change', () => {
			if (reduceMotion.matches) stopLoop();
			else if (!pausedByUser) startLoop(false);
		});

		// Initial state: hold on the first frame when reduced motion is preferred,
		// leaving the user to opt in with the toggle.
		if (reduceMotion.matches) {
			video.style.opacity = '1';
			reflectState(false);
		} else {
			startLoop(false);
		}
	}
</script>
</FlightTrainingCenterLayout>

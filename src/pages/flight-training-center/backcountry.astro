---
import FlightTrainingCenterLayout from "../../layouts/FlightTrainingCenterLayout.astro";
import ContactSection from "../../components/sections/ContactSection.astro";
import BreadcrumbSchema from "../../components/seo/BreadcrumbSchema.astro";
import ServiceSchema from "../../components/seo/ServiceSchema.astro";
import site from "../../data/site.json";

const breadcrumbs = [
  { name: 'Home', url: 'https://www.flyingsma.com/' },
  { name: 'Flight Training Center', url: 'https://www.flyingsma.com/flight-training-center/' },
  { name: 'Backcountry Experience', url: 'https://www.flyingsma.com/flight-training-center/backcountry/' },
];
---

<FlightTrainingCenterLayout
	title="Backcountry Experience"
	description="A four-hour backcountry flying adventure from Southern Maine Aviation. Learn to get in and out of small grass and dirt strips."
>
	<BreadcrumbSchema slot="head" items={breadcrumbs} />
	<ServiceSchema
		slot="head"
		name="Backcountry Flying Experience"
		description="Four-hour backcountry flying experience at Southern Maine Aviation, covering short, soft and unimproved strip technique."
		url="https://www.flyingsma.com/flight-training-center/backcountry/"
		serviceType="Flight Training"
	/>
	<!-- Page Header -->
	<section class="relative text-white py-20 md:py-28 overflow-hidden">
		<div
			class="absolute inset-0 bg-cover bg-center bg-no-repeat"
			style="background-image: url('/images/fly/backcountry-training.jpg');"
		></div>
		<div class="absolute inset-0 bg-gradient-to-br from-slate-950/95 via-emerald-900/80 to-sky-800/75"></div>

		<div class="container mx-auto px-4 text-center relative z-10">
			<span class="inline-block bg-emerald-400 text-emerald-950 text-sm font-bold px-4 py-1 rounded-full mb-6 shadow-lg uppercase tracking-wide">
				Four-Hour Adventure
			</span>
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 drop-shadow-lg">Backcountry Experience</h1>
			<p class="text-xl md:text-2xl text-emerald-50 max-w-3xl mx-auto mb-8 drop-shadow">
				Grass strips, dirt strips and the airports that never make it onto a chart. Adventure beyond the pavement.
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a
					href={`tel:${site.contact.flight.phone}`}
					class="inline-flex items-center px-8 py-4 bg-white text-emerald-900 font-semibold rounded-lg hover:bg-emerald-50 transition-colors shadow-lg"
				>
					<i class="fa-solid fa-phone mr-2"></i>
					Call or Text: {site.contact.flight.phone}
				</a>
			</div>
		</div>
	</section>

	<!-- Main Content -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<p class="text-xl text-gray-700 leading-relaxed mb-8">
					Spend four hours learning how to get in and out of small grass and dirt strips. New England has dozens
					of great airports that never appear on most pilots' radar — some charted, many not — and this is how
					you start using them.
				</p>

				<div class="grid md:grid-cols-2 gap-8 my-12">
					<div class="bg-emerald-50 rounded-xl p-8">
						<h3 class="text-2xl font-bold text-gray-900 mb-4">What You'll Work On</h3>
						<ul class="space-y-4 text-gray-700">
							<li class="flex items-start">
								<i class="fa-solid fa-check text-emerald-600 mr-3 mt-1 flex-shrink-0"></i>
								<span><strong>Short field technique:</strong> Getting in and back out of strips with no margin to waste</span>
							</li>
							<li class="flex items-start">
								<i class="fa-solid fa-check text-emerald-600 mr-3 mt-1 flex-shrink-0"></i>
								<span><strong>Soft field work:</strong> Grass and dirt behave nothing like a paved runway</span>
							</li>
							<li class="flex items-start">
								<i class="fa-solid fa-check text-emerald-600 mr-3 mt-1 flex-shrink-0"></i>
								<span><strong>Judging a strip from the air:</strong> Surface, slope, length and what the wind is doing</span>
							</li>
							<li class="flex items-start">
								<i class="fa-solid fa-check text-emerald-600 mr-3 mt-1 flex-shrink-0"></i>
								<span><strong>Knowing when to say no:</strong> The most important backcountry skill there is</span>
							</li>
						</ul>
					</div>

					<div class="grid grid-rows-2 gap-4">
						<img src="/images/fly/backcountry-training/1.jpg" alt="Backcountry flying at Southern Maine Aviation" class="w-full h-full object-cover rounded-xl shadow" loading="lazy" />
						<img src="/images/fly/backcountry-training/2.jpg" alt="Aircraft on a grass strip" class="w-full h-full object-cover rounded-xl shadow" loading="lazy" />
					</div>
				</div>

				<!-- Prerequisites -->
				<div class="bg-gray-50 rounded-xl p-8 my-12">
					<h3 class="text-2xl font-bold text-gray-900 mb-4">Who Can Come</h3>
					<p class="text-gray-700 mb-4">
						This is open to anyone already training, not just certificated pilots. You must at least have a
						student pilot certificate.
					</p>
					<ul class="space-y-2 text-gray-700">
						<li class="flex items-center">
							<i class="fa-solid fa-chevron-right text-gray-500 mr-3"></i>
							Student pilot certificate (minimum)
						</li>
						<li class="flex items-center">
							<i class="fa-solid fa-chevron-right text-gray-500 mr-3"></i>
							Four hours set aside for the experience
						</li>
					</ul>
					<p class="text-gray-600 text-sm mt-4">
						Call for current pricing and to check aircraft and instructor availability.
					</p>
				</div>

				<!-- Related -->
				<div class="bg-white border border-gray-200 rounded-xl p-8 my-12">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Worth Doing First</h3>
					<p class="text-gray-700 mb-4">
						Backcountry work and tailwheel flying go hand in hand — the rudder skills transfer directly.
					</p>
					<a href="/flight-training-center/tailwheel" class="inline-flex items-center px-5 py-3 bg-sky-50 text-sky-700 font-medium rounded-lg hover:bg-sky-100 transition-colors">
						Tailwheel Endorsement
						<i class="fa-solid fa-chevron-right text-xs ml-2"></i>
					</a>
				</div>

				<!-- CTA -->
				<div class="bg-gradient-to-r from-emerald-600 to-sky-700 rounded-2xl p-8 md:p-12 text-white text-center my-12">
					<h2 class="text-3xl font-bold mb-4">Ready to Leave the Pavement?</h2>
					<p class="text-emerald-50 text-lg mb-6">
						Get in touch to book your four-hour backcountry experience.
					</p>
					<div class="flex flex-wrap justify-center gap-4">
						<a
							href={`tel:${site.contact.flight.phone}`}
							class="inline-flex items-center px-8 py-4 bg-white text-emerald-700 font-semibold rounded-lg hover:bg-emerald-50 transition-colors"
						>
							<i class="fa-solid fa-phone mr-2"></i>
							Call: {site.contact.flight.phone}
						</a>
						<a
							href={`mailto:${site.contact.flight.email}`}
							class="inline-flex items-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
						>
							<i class="fa-solid fa-envelope mr-2"></i>
							Email Us
						</a>
					</div>
				</div>

				<div class="text-center">
					<a href="/flight-training-center" class="inline-flex items-center text-sky-600 hover:text-sky-800 font-medium">
						<i class="fa-solid fa-chevron-left mr-2"></i>
						Back to All Training Programs
					</a>
				</div>
			</div>
		</div>
	</section>

	<ContactSection
		title="Questions About Backcountry Flying?"
		description="Ask us about aircraft, timing and what the four hours actually covers."
		variant="default"
		showMap={false}
	/>
</FlightTrainingCenterLayout>

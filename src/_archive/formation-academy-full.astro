    title="Ready to Learn More About Formation Academy?"
    description="Our instructors are happy to walk you through the program, upcoming cohort dates, and what to expect on day one."
    variant="default"
    showMap={false}
  />

  <script>
    const triggers = document.querySelectorAll('.faq-trigger');
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.faq-item');
        const answer = item?.querySelector('.faq-answer') as HTMLElement | null;
        const chevron = trigger.querySelector('.faq-chevron') as HTMLElement | null;
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        // Close all others
        triggers.forEach((other) => {
          if (other !== trigger) {
            other.setAttribute('aria-expanded', 'false');
            const otherAnswer = other.closest('.faq-item')?.querySelector('.faq-answer') as HTMLElement | null;
            const otherChevron = other.querySelector('.faq-chevron') as HTMLElement | null;
            if (otherAnswer) otherAnswer.style.maxHeight = '0';
            if (otherChevron) otherChevron.style.transform = '';
          }
        });

        // Toggle this one
        trigger.setAttribute('aria-expanded', String(!isOpen));
        if (answer) {
          answer.style.maxHeight = isOpen ? '0' : `${answer.scrollHeight}px`;
        }
        if (chevron) {
          chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        }
      });
    });
  </script>

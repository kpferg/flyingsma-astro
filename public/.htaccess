# Apache configuration for flyingsma.com
#
# This file is served from the site root. Astro copies it from public/ into
# dist/ at build time, so it deploys over FTP like any other file.
#
# NOTE: if the host does not permit these directives, Apache returns 500 for
# the whole site. Upload it, load the site immediately, and delete the file if
# anything breaks — removing it fully reverts the change.


# ---------------------------------------------------------------------------
# Custom error page
# ---------------------------------------------------------------------------
# Without this, an unknown URL returns a bare "404 Not Found" with no styling
# and no way back into the site. The built 404 page is at /404.html.

ErrorDocument 404 /404.html


# ---------------------------------------------------------------------------
# Canonical host: send flyingsma.com to www.flyingsma.com
# ---------------------------------------------------------------------------
# Both hostnames serve the same document root, so without a redirect every page
# exists at two addresses and search engines have to guess which is canonical.
#
# www is the canonical form: it is what astro.config.mjs declares as `site`,
# what every <link rel="canonical"> and structured-data URL in the pages says,
# and what the sitemap lists.
#
# Wrapped in IfModule so a host without mod_rewrite ignores this rather than
# failing the whole site.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One rule handles both http->https and apex->www, so any combination
  # reaches https://www.flyingsma.com/ in a single hop.
  #
  # The two HTTPS conditions are both required. %{HTTPS} is what Apache sets
  # when it terminates TLS itself; X-Forwarded-Proto is what a TLS-terminating
  # proxy sets instead. Testing only the first would send every request into an
  # infinite redirect loop on a proxied host.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://www.flyingsma.com/$1 [R=301,L]

  # Already on https, but on the apex rather than www.
  RewriteCond %{HTTP_HOST} ^flyingsma\.com$ [NC]
  RewriteRule ^(.*)$ https://www.flyingsma.com/$1 [R=301,L]
</IfModule>


# ---------------------------------------------------------------------------
# Upgrade insecure subresource requests
# ---------------------------------------------------------------------------
# Restored from the .htaccess this file replaced, which an SSL tool had
# generated (recovered from .easyssl_backup on the server).
#
# The original attached this header only to the redirect response, via
# `env=UPGRADE` set by the rewrite. A CSP on a 301 has no content to govern,
# so it is set on every response here instead, which is what actually protects
# the pages.
#
# Safe for this site: no page loads an http:// subresource. The few plain-http
# links in the markup are outbound <a href> links, which this does not affect.

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "upgrade-insecure-requests;"
</IfModule>
